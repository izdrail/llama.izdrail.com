# Host API port for the OpenAI-compatible llama.cpp server.
LLAMA_CPP_PORT=8080

# Release the Quadro P2000's VRAM quickly when idle.
LLAMA_CPP_SLEEP_IDLE_SECONDS=60

# Served model: Qwen3-4B Q4_K_M by default. Swapping models is a three-var
# change (repo/file/alias), e.g. the Laravel-tuned model:
#   LLAMA_CPP_HF_REPO=laravelcompany/laravelmail
#   LLAMA_CPP_HF_FILE=llama-3.2-3b-instruct.Q4_K_M.gguf
#   LLAMA_CPP_MODEL_ALIAS=laravelmail
LLAMA_CPP_HF_REPO=unsloth/Qwen3-4B-GGUF
LLAMA_CPP_HF_FILE=Qwen3-4B-Q4_K_M.gguf
LLAMA_CPP_MODEL_ALIAS=qwen3-4b
LLAMA_CPP_CONTEXT_SIZE=4096

# Only needed for a private or gated Hugging Face model.
HF_TOKEN=

# --- tracker (query log + web UI) -----------------------------------------
TRACKER_PORT=8088
TRACKER_UPSTREAM=http://llama-cpp:8080
TRACKER_MAX_LOG_MB=2048
TRACKER_MAX_BODY_KB=256
# Set via Coolify env / local .env, never commit real values:
TRACKER_AUTH_USERNAME=
TRACKER_AUTH_PASSWORD=
TRACKER_SESSION_SECRET=
# Optional inference Bearer gate - blank = open (current live behavior).
TRACKER_API_TOKEN=
